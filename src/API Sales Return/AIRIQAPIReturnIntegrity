codeunit 50733 "AIRIQ API SR Integrity"
{
    Permissions =
        tabledata "AIRIQ API SR Return Registry" = rimd;

    procedure Audit()
    var
        Source: Record "API Sales Return";
    begin
        Source.LockTable();

        if Source.FindSet() then
            repeat
                Claim(Source);
            until Source.Next() = 0;
    end;

    local procedure Claim(Source: Record "API Sales Return")
    var
        Registry: Record "AIRIQ API SR Return Registry";
        Other: Record "API Sales Return";
    begin
        if Source.IsTemporary() or
           (Source."Return No." = '') then
            exit;

        Registry.LockTable();

        if Registry.Get(Source."Return No.") then begin
            if Registry."Serial No." <> Source."Serial No." then
                Error(
                    'Sales Return with Return No. %1 already exists.',
                    Source."Return No.");
        end else begin
            Registry.Init();
            Registry."Return No." := Source."Return No.";
            Registry."Serial No." := Source."Serial No.";
            Registry.Insert();
        end;

        Other.SetRange(
            "Return No.",
            Source."Return No.");

        Other.SetFilter(
            "Serial No.",
            '<>%1',
            Source."Serial No.");

        if not Other.IsEmpty() then
            Error(
                'Sales Return with Return No. %1 already exists.',
                Source."Return No.");
    end;

    local procedure Release(Source: Record "API Sales Return")
    var
        Registry: Record "AIRIQ API SR Return Registry";
    begin
        if Source.IsTemporary() or
           (Source."Return No." = '') then
            exit;

        Registry.LockTable();

        if Registry.Get(Source."Return No.") then
            if Registry."Serial No." = Source."Serial No." then
                Registry.Delete();
    end;

    [EventSubscriber(
        ObjectType::Table,
        Database::"API Sales Return",
        'OnAfterInsertEvent',
        '',
        false,
        false)]
    local procedure Inserted(
        var Rec: Record "API Sales Return";
        RunTrigger: Boolean)
    begin
        Claim(Rec);
    end;

    [EventSubscriber(
        ObjectType::Table,
        Database::"API Sales Return",
        'OnAfterModifyEvent',
        '',
        false,
        false)]
    local procedure Modified(
        var Rec: Record "API Sales Return";
        var xRec: Record "API Sales Return";
        RunTrigger: Boolean)
    begin
        if Rec.IsTemporary() then
            exit;

        if xRec."Sales Credit Memo Created" and
           (Rec."Return No." <> xRec."Return No.") then
            Error(
                'Return No. cannot change after Sales Credit Memo was created.');

        if Rec."Return No." <> xRec."Return No." then
            Release(xRec);

        Claim(Rec);
    end;

    [EventSubscriber(
        ObjectType::Table,
        Database::"API Sales Return",
        'OnAfterDeleteEvent',
        '',
        false,
        false)]
    local procedure Deleted(
        var Rec: Record "API Sales Return";
        RunTrigger: Boolean)
    begin
        if Rec.IsTemporary() then
            exit;

        // Allow deletion even after Credit Memo creation.
        // The Credit Memo itself is NOT deleted.

        // Remove passenger staging details.
        RemovePassengers(Rec);

        // Release Return No. from custom registry.
        Release(Rec);
    end;

    local procedure RemovePassengers(
        Source: Record "API Sales Return")
    var
        Passenger: Record "API Sales Return Passenger";
    begin
        Passenger.SetRange(
            "Return No.",
            Source."Return No.");

        Passenger.SetRange(
            PNR,
            Source.PNR);

        Passenger.DeleteAll(true);
    end;

    [EventSubscriber(
        ObjectType::Table,
        Database::"API Sales Return",
        'OnAfterRenameEvent',
        '',
        false,
        false)]
    local procedure Renamed(
        var Rec: Record "API Sales Return";
        var xRec: Record "API Sales Return";
        RunTrigger: Boolean)
    begin
        if Rec.IsTemporary() then
            exit;

        if Rec."Sales Credit Memo Created" then
            Error(
                'A Sales Return linked to a credit memo cannot be renamed.');

        Release(xRec);
        Claim(Rec);
    end;
}

