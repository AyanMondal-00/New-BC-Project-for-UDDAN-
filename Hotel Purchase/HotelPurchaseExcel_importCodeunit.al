
codeunit 50440 "Hotel Purchase Exl Import Mgt."
{
    procedure ImportFromExcel()
    var
        TempExcelBuffer: Record "Excel Buffer" temporary;
        HotelPurchase: Record "Hotel Purchase";
        ExistingHotel: Record "Hotel Purchase";
        UploadInStream: InStream;
        FileName: Text;
        SheetName: Text;
        RowNo: Integer;
        LastRowNo: Integer;
        ImportedCount: Integer;
        SkippedCount: Integer;
        DuplicateCount: Integer;
        VoucherValue: Code[50];
        RawVoucher: Text;
        PurchaseDateText: Text;
        InventoryText: Text;
    begin
        if not UploadIntoStream(
            'Select Hotel Purchase Excel File',
            '',
            'Excel Files (*.xlsx)|*.xlsx',
            FileName,
            UploadInStream)
        then
            exit;

        SheetName :=
            TempExcelBuffer.SelectSheetsNameStream(
                UploadInStream);

        if SheetName = '' then
            exit;

        UploadInStream.ResetPosition();

        TempExcelBuffer.OpenBookStream(
            UploadInStream, SheetName);

        TempExcelBuffer.ReadSheet();

        CheckHeaders(TempExcelBuffer);

        TempExcelBuffer.Reset();

        if not TempExcelBuffer.FindLast() then
            Error('The selected Excel file is empty.');

        LastRowNo := TempExcelBuffer."Row No.";

        if LastRowNo < 2 then
            Error('No data rows found in Excel.');

        for RowNo := 2 to LastRowNo do begin

            PurchaseDateText :=
                GetCellValue(
                    TempExcelBuffer, RowNo, 2);

            RawVoucher :=
                GetCellValue(
                    TempExcelBuffer, RowNo, 4);

            InventoryText :=
                GetCellValue(
                    TempExcelBuffer, RowNo, 12);

            // Skip completely blank rows
            if (PurchaseDateText = '') and
               (RawVoucher = '') and
               (InventoryText = '') then
                SkippedCount += 1

            // Skip mapping instruction rows
            else if
                (StrPos(
                    UpperCase(PurchaseDateText),
                    'MAP') > 0) then
                SkippedCount += 1

            else begin

                if RawVoucher = '' then
                    Error(
                        'Voucher Number is blank at Excel row %1.',
                        RowNo);

                if StrLen(RawVoucher) > 50 then
                    Error(
                        'Voucher Number exceeds 50 characters at Excel row %1.',
                        RowNo);

                VoucherValue := CopyStr(RawVoucher, 1, 50);

                // Duplicate checking
                ExistingHotel.Reset();
                ExistingHotel.SetRange(
                    "Voucher Number", VoucherValue);

                if not ExistingHotel.IsEmpty() then
                    DuplicateCount += 1
                else begin

                    HotelPurchase.Init();

                    // A: Serial No.
                    // Automatically generated by table

                    // B: Purchase Date
                    HotelPurchase.Validate(
                        "Purchase Date",
                        GetDateTimeValue(
                            TempExcelBuffer, RowNo, 2));

                    // C: Entry Date
                    HotelPurchase.Validate(
                        "Entry Date",
                        GetDateTimeValue(
                            TempExcelBuffer, RowNo, 3));

                    // D: Voucher Number
                    HotelPurchase.Validate(
                        "Voucher Number",
                        VoucherValue);

                    // E: Select
                    HotelPurchase.Select := false;

                    // F: Invoice Created
                    HotelPurchase."Invoice Created" := 'No';

                    // G: Invoice Posted
                    HotelPurchase."Invoice Posted" := 'No';

                    // H: Item Created
                    HotelPurchase."Item Created" := 'No';

                    // I: CGST
                    HotelPurchase.Validate(
                        CGST,
                        GetDecimalValue(
                            GetCellValue(
                                TempExcelBuffer, RowNo, 9),
                            RowNo, 'CGST'));

                    // J: SGST
                    HotelPurchase.Validate(
                        SGST,
                        GetDecimalValue(
                            GetCellValue(
                                TempExcelBuffer, RowNo, 10),
                            RowNo, 'SGST'));

                    // K: IGST
                    HotelPurchase.Validate(
                        IGST,
                        GetDecimalValue(
                            GetCellValue(
                                TempExcelBuffer, RowNo, 11),
                            RowNo, 'IGST'));

                    // L: Inventory
                    HotelPurchase.Validate(
                        Inventory,
                        CopyStr(
                            InventoryText,
                            1,
                            MaxStrLen(HotelPurchase.Inventory)));

                    // M: Total Quantity
                    HotelPurchase.Validate(
                        "Total Quantity",
                        GetDecimalValue(
                            GetCellValue(
                                TempExcelBuffer, RowNo, 13),
                            RowNo, 'Total Quantity'));

                    // N: Rate
                    HotelPurchase.Validate(
                        Rate,
                        GetDecimalValue(
                            GetCellValue(
                                TempExcelBuffer, RowNo, 14),
                            RowNo, 'Rate'));

                    // O: Total Amount
                    HotelPurchase.Validate(
                        "Total Amount",
                        GetDecimalValue(
                            GetCellValue(
                                TempExcelBuffer, RowNo, 15),
                            RowNo, 'Total Amount'));

                    // Auto Serial No. on Insert
                    HotelPurchase.Insert(true);

                    ImportedCount += 1;
                end;
            end;
        end;

        Message(
            'Hotel Purchase Excel Import Completed.\' +
            'Imported: %1\' +
            'Duplicate Voucher Numbers: %2\' +
            'Skipped Blank/Instruction Rows: %3',
            ImportedCount,
            DuplicateCount,
            SkippedCount);
    end;

    // =====================================
    // EXCEL HEADER VALIDATION
    // =====================================

    local procedure CheckHeaders(
        var TempExcelBuffer: Record "Excel Buffer" temporary)
    var
        Headers: List of [Text];
        Expected: Text;
        Actual: Text;
        ColNo: Integer;
    begin
        Headers.Add('Serial No.');
        Headers.Add('Purchase Date');
        Headers.Add('Entry Date');
        Headers.Add('Voucher Number');
        Headers.Add('Select');
        Headers.Add('Invoice Created');
        Headers.Add('Invoice Posted');
        Headers.Add('Item Created');
        Headers.Add('CGST');
        Headers.Add('SGST');
        Headers.Add('IGST');
        Headers.Add('Inventory');
        Headers.Add('Total Quantity');
        Headers.Add('Rate');
        Headers.Add('Total Amount');

        ColNo := 0;

        foreach Expected in Headers do begin
            ColNo += 1;

            Actual :=
                DelChr(
                    GetCellValue(
                        TempExcelBuffer, 1, ColNo),
                    '<>', ' ');

            if UpperCase(Actual) <> UpperCase(Expected) then
                Error(
                    'Excel header mismatch at column %1. Expected "%2", found "%3".',
                    ColNo, Expected, Actual);
        end;
    end;

    // =====================================
    // GET CELL VALUE
    // =====================================

    local procedure GetCellValue(
        var TempExcelBuffer: Record "Excel Buffer" temporary;
        RowNo: Integer;
        ColumnNo: Integer): Text
    begin
        TempExcelBuffer.Reset();
        TempExcelBuffer.SetRange("Row No.", RowNo);
        TempExcelBuffer.SetRange("Column No.", ColumnNo);

        if TempExcelBuffer.FindFirst() then
            exit(
                DelChr(
                    TempExcelBuffer."Cell Value as Text",
                    '<>', ' '));

        exit('');
    end;

    // =====================================
    // DECIMAL CONVERSION
    // =====================================

    local procedure GetDecimalValue(
        ValueText: Text;
        RowNo: Integer;
        FieldName: Text): Decimal
    var
        DecimalValue: Decimal;
    begin
        if ValueText = '' then
            exit(0);

        if Evaluate(DecimalValue, ValueText, 9) then
            exit(DecimalValue);

        if Evaluate(DecimalValue, ValueText) then
            exit(DecimalValue);

        Error(
            'Invalid %1 at Excel row %2: %3',
            FieldName,
            RowNo,
            ValueText);
    end;

    // =====================================
    // DATETIME CONVERSION
    // DD-MM-YYYY HH:MM
    // DD.MM.YYYY HH:MM
    // =====================================

    local procedure GetDateTimeValue(
        var TempExcelBuffer: Record "Excel Buffer" temporary;
        RowNo: Integer;
        ColumnNo: Integer): DateTime
    var
        CellValue: Text;
        DatePart: Text;
        TimePart: Text;
        DateParts: List of [Text];
        ParsedDateTime: DateTime;
        ParsedDate: Date;
        ParsedTime: Time;
        DayNo: Integer;
        MonthNo: Integer;
        YearNo: Integer;
        FirstSpace: Integer;
    begin
        CellValue :=
            GetCellValue(
                TempExcelBuffer, RowNo, ColumnNo);

        if CellValue = '' then
            exit(0DT);

        FirstSpace := StrPos(CellValue, ' ');

        if FirstSpace > 0 then begin
            DatePart :=
                CopyStr(
                    CellValue, 1, FirstSpace - 1);

            TimePart :=
                DelChr(
                    CopyStr(CellValue, FirstSpace + 1),
                    '<>', ' ');
        end else begin
            DatePart := CellValue;
            TimePart := '';
        end;

        DatePart := ConvertStr(DatePart, '.', '-');
        DateParts := DatePart.Split('-');

        if DateParts.Count() = 3 then begin
            if Evaluate(DayNo, DateParts.Get(1)) and
               Evaluate(MonthNo, DateParts.Get(2)) and
               Evaluate(YearNo, DateParts.Get(3)) then begin

                if (YearNo >= 1000) and
                   (YearNo <= 9999) and
                   (MonthNo >= 1) and
                   (MonthNo <= 12) and
                   (DayNo >= 1) and
                   (DayNo <= 31) then begin

                    ParsedDate :=
                        DMY2Date(DayNo, MonthNo, YearNo);

                    if TimePart = '' then
                        ParsedTime := 000000T
                    else
                        if not Evaluate(
                            ParsedTime, TimePart) then
                            Error(
                                'Invalid Time at Excel row %1, column %2: %3',
                                RowNo, ColumnNo, TimePart);

                    exit(
                        CreateDateTime(
                            ParsedDate, ParsedTime));
                end;
            end;
        end;

        if Evaluate(ParsedDateTime, CellValue) then
            exit(ParsedDateTime);

        if Evaluate(ParsedDateTime, CellValue, 9) then
            exit(ParsedDateTime);

        if Evaluate(ParsedDate, CellValue) then
            exit(
                CreateDateTime(
                    ParsedDate, 000000T));

        Error(
            'Invalid DateTime at Excel row %1, column %2: "%3".',
            RowNo, ColumnNo, CellValue);
    end;
}
