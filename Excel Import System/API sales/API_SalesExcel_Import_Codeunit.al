
codeunit 50453 "API Sales Excel Import Mgt."
{
    procedure ImportFromExcel()
    var
        ExcelBuffer: Record "Excel Buffer" temporary;
        APISales: Record "API Sales Format";
        ExistingSales: Record "API Sales Format";
        NormalSales: Record "Normal Sales";
        ThirdPartySales: Record "Third-Party Supplier Sales";
        InStream: InStream;
        FileName: Text;
        SheetName: Text;
        RowNo: Integer;
        LastRow: Integer;
        ImportedCount: Integer;
        DuplicateCount: Integer;
        BlankCount: Integer;
        AQNumber: BigInteger;
        PNRValue: Text[10];
        NamesText: Text;
        IDsText: Text;
        TypesText: Text;
        CellText: Text;
        PassengerCount: Integer;
        TotalPassengerCount: Integer;
    begin
        if not UploadIntoStream(
            'Select API Sales Excel File',
            '',
            'Excel Files (*.xlsx)|*.xlsx',
            FileName,
            InStream)
        then
            exit;

        SheetName := ExcelBuffer.SelectSheetsNameStream(InStream);

        if SheetName = '' then
            exit;

        InStream.ResetPosition();

        ExcelBuffer.OpenBookStream(InStream, SheetName);
        ExcelBuffer.ReadSheet();

        CheckHeaders(ExcelBuffer);

        ExcelBuffer.Reset();

        if not ExcelBuffer.FindLast() then
            Error('The selected Excel file is empty.');

        LastRow := ExcelBuffer."Row No.";

        if LastRow < 2 then
            Error('No data rows found in Excel.');

        for RowNo := 2 to LastRow do begin

            PNRValue := CopyStr(
                GetCellText(ExcelBuffer, RowNo, 9),
                1, 10);

            CellText := GetCellText(ExcelBuffer, RowNo, 6);

            if (PNRValue = '') and (CellText = '') then
                BlankCount += 1
            else begin

                if not Evaluate(AQNumber, CellText) then
                    Error(
                        'Invalid Ref No./AQ Number at Excel row %1: %2',
                        RowNo, CellText);

                if AQNumber = 0 then
                    Error(
                        'Ref No./AQ Number cannot be zero at Excel row %1.',
                        RowNo);

                if PNRValue = '' then
                    Error(
                        'PNR is blank at Excel row %1.',
                        RowNo);

                // Duplicate AQ Number check.
                ExistingSales.Reset();
                ExistingSales.SetRange(
                    "Ref No./AQ Number", AQNumber);

                if not ExistingSales.IsEmpty() then
                    DuplicateCount += 1
                else begin

                    // Duplicate PNR check.
                    ExistingSales.Reset();
                    ExistingSales.SetRange(PNR, PNRValue);

                    if not ExistingSales.IsEmpty() then
                        DuplicateCount += 1
                    else begin

                        // Passenger columns.
                        NamesText :=
                            GetCellText(ExcelBuffer, RowNo, 10);

                        IDsText :=
                            GetCellText(ExcelBuffer, RowNo, 11);

                        TypesText :=
                            GetCellText(ExcelBuffer, RowNo, 12);

                        // Validate passenger data before insert.
                        PassengerCount := CheckPassengers(
                            NamesText,
                            IDsText,
                            TypesText,
                            RowNo);

                        // Prevent cross-table AQ Number duplicates.
                        NormalSales.Reset();
                        NormalSales.SetRange(
                            "Ref No./AQ Number", AQNumber);

                        if not NormalSales.IsEmpty() then
                            Error(
                                'AQ Number %1 at Excel row %2 already exists in Normal Sales.',
                                AQNumber, RowNo);

                        ThirdPartySales.Reset();
                        ThirdPartySales.SetRange(
                            "Ref No./AQ Number", AQNumber);

                        if not ThirdPartySales.IsEmpty() then
                            Error(
                                'AQ Number %1 at Excel row %2 already exists in Third-Party Supplier Sales.',
                                AQNumber, RowNo);

                        Clear(APISales);
                        APISales.Init();

                        // Column 1 ignored.
                        // Serial No. generated by table OnInsert.

                        // Column 2: Date
                        CellText :=
                            GetCellText(ExcelBuffer, RowNo, 2);

                        if CellText <> '' then
                            APISales.Date :=
                                ParseExcelDateTime(
                                    CellText, RowNo, 2);

                        // Column 3: Invoice Number
                        APISales."Invoice Number" :=
                            CopyStr(
                                GetCellText(ExcelBuffer, RowNo, 3),
                                1, 50);

                        // Column 4: Agency ID
                        APISales."Agency ID" :=
                            CopyStr(
                                GetCellText(ExcelBuffer, RowNo, 4),
                                1, 30);

                        // Column 5: Agency Name
                        APISales."Agency Name" :=
                            CopyStr(
                                GetCellText(ExcelBuffer, RowNo, 5),
                                1, 100);

                        // Column 6: AQ Number
                        APISales.Validate(
                            "Ref No./AQ Number", AQNumber);

                        // Column 7: Select
                        APISales."Select" :=
                            ParseBoolean(
                                GetCellText(ExcelBuffer, RowNo, 7),
                                RowNo);

                        // Column 8: Sales Invoice Created
                        // New imports must not be marked as invoiced.
                        APISales."Sales Invoice Created" := false;

                        // Column 9: PNR
                        APISales.PNR := PNRValue;

                        // Column 10: Passenger names
                        APISales.Passenger :=
                            CopyStr(NamesText, 1, 100);

                        // Column 13: Pax
                        CellText :=
                            GetCellText(ExcelBuffer, RowNo, 13);

                        if CellText <> '' then begin
                            if not Evaluate(APISales.Pax, CellText) then
                                Error(
                                    'Invalid Pax "%1" at Excel row %2.',
                                    CellText, RowNo);
                        end;

                        // Column 14: Travel Date
                        CellText :=
                            GetCellText(ExcelBuffer, RowNo, 14);

                        if CellText <> '' then
                            APISales."Travel Date" :=
                                ParseExcelDateTime(
                                    CellText, RowNo, 14);

                        // Column 15: Sector
                        APISales.Sector :=
                            CopyStr(
                                GetCellText(ExcelBuffer, RowNo, 15),
                                1, 200);

                        // Column 16: Type
                        APISales.Type :=
                            CopyStr(
                                GetCellText(ExcelBuffer, RowNo, 16),
                                1, 50);

                        // Column 17: Rate
                        CellText :=
                            GetCellText(ExcelBuffer, RowNo, 17);

                        if CellText <> '' then
                            APISales.Rate :=
                                ParseDecimal(
                                    CellText, RowNo, 'Rate');

                        // Column 18: Total Amount
                        CellText :=
                            GetCellText(ExcelBuffer, RowNo, 18);

                        if CellText <> '' then
                            APISales."Total Amount" :=
                                ParseDecimal(
                                    CellText, RowNo, 'Total Amount');

                        // Main record insert.
                        APISales.Insert(true);

                        // Passenger detail records insert.
                        ImportPassengers(
                            AQNumber,
                            PNRValue,
                            NamesText,
                            IDsText,
                            TypesText,
                            RowNo);

                        ImportedCount += 1;
                        TotalPassengerCount += PassengerCount;
                    end;
                end;
            end;
        end;

        Message(
            'API Sales Excel Import Completed.\' +
            'Imported Records: %1\' +
            'Imported Passengers: %2\' +
            'Duplicate Skipped: %3\' +
            'Blank Rows Skipped: %4',
            ImportedCount,
            TotalPassengerCount,
            DuplicateCount,
            BlankCount);
    end;

    local procedure CheckHeaders(
        var ExcelBuffer: Record "Excel Buffer" temporary)
    begin
        CheckHeader(ExcelBuffer, 1, 'Serial No.');
        CheckHeader(ExcelBuffer, 2, 'Date');
        CheckHeader(ExcelBuffer, 3, 'Invoice Number');
        CheckHeader(ExcelBuffer, 4, 'Agency ID');
        CheckHeader(ExcelBuffer, 5, 'Agency Name');
        CheckHeader(ExcelBuffer, 6, 'Ref No./AQ Number');
        CheckHeader(ExcelBuffer, 7, 'Select');
        CheckHeader(ExcelBuffer, 8, 'Sales Invoice Created');
        CheckHeader(ExcelBuffer, 9, 'PNR');
        CheckHeader(ExcelBuffer, 10, 'View Passenger');
        CheckHeader(ExcelBuffer, 11, 'Passenger ID');
        CheckHeader(ExcelBuffer, 12, 'Passenger Type');
        CheckHeader(ExcelBuffer, 13, 'Pax');
        CheckHeader(ExcelBuffer, 14, 'Travel Date');
        CheckHeader(ExcelBuffer, 15, 'Sector');
        CheckHeader(ExcelBuffer, 16, 'Type');
        CheckHeader(ExcelBuffer, 17, 'Rate');
        CheckHeader(ExcelBuffer, 18, 'Total Amount');
    end;

    local procedure CheckHeader(
        var ExcelBuffer: Record "Excel Buffer" temporary;
        ColumnNo: Integer;
        ExpectedHeader: Text)
    var
        ActualHeader: Text;
    begin
        ActualHeader :=
            GetCellText(ExcelBuffer, 1, ColumnNo);

        if UpperCase(DelChr(ActualHeader, '=', ' _-')) <>
           UpperCase(DelChr(ExpectedHeader, '=', ' _-'))
        then
            Error(
                'Invalid Excel header at column %1.\' +
                'Expected: %2\Found: %3',
                ColumnNo,
                ExpectedHeader,
                ActualHeader);
    end;

    local procedure CheckPassengers(
        NamesText: Text;
        IDsText: Text;
        TypesText: Text;
        RowNo: Integer): Integer
    var
        NamesList: List of [Text];
        IDsList: List of [Text];
        TypesList: List of [Text];
        SingleName: Text;
        SingleID: Text;
        SingleType: Text;
        PassengerID: BigInteger;
        I: Integer;
    begin
        if (NamesText = '') and
           (IDsText = '') and
           (TypesText = '')
        then
            exit(0);

        NamesList := NamesText.Split(',');
        IDsList := IDsText.Split(',');
        TypesList := TypesText.Split(',');

        if (NamesList.Count <> IDsList.Count) or
           (NamesList.Count <> TypesList.Count)
        then
            Error(
                'Passenger count mismatch at Excel row %1: Names=%2, IDs=%3, Types=%4.',
                RowNo,
                NamesList.Count,
                IDsList.Count,
                TypesList.Count);

        for I := 1 to NamesList.Count do begin

            SingleName :=
                DelChr(NamesList.Get(I), '<>', ' ');

            SingleID :=
                DelChr(IDsList.Get(I), '<>', ' ');

            SingleType :=
                DelChr(TypesList.Get(I), '<>', ' ');

            if SingleName = '' then
                Error(
                    'Passenger Name is blank at Excel row %1, passenger %2.',
                    RowNo, I);

            if StrLen(SingleName) > 100 then
                Error(
                    'Passenger Name exceeds 100 characters at Excel row %1, passenger %2.',
                    RowNo, I);

            if SingleID = '' then
                Error(
                    'Passenger ID is blank at Excel row %1, passenger %2.',
                    RowNo, I);

            if not Evaluate(PassengerID, SingleID) then
                Error(
                    'Invalid Passenger ID "%1" at Excel row %2, passenger %3.',
                    SingleID, RowNo, I);

            if SingleType = '' then
                Error(
                    'Passenger Type is blank at Excel row %1, passenger %2.',
                    RowNo, I);

            if StrLen(SingleType) > 50 then
                Error(
                    'Passenger Type exceeds 50 characters at Excel row %1, passenger %2.',
                    RowNo, I);
        end;

        exit(NamesList.Count);
    end;

    local procedure ImportPassengers(
        AQNumber: BigInteger;
        PNRValue: Text[10];
        NamesText: Text;
        IDsText: Text;
        TypesText: Text;
        RowNo: Integer)
    var
        Passenger: Record "API Sales Passenger Name";
        NamesList: List of [Text];
        IDsList: List of [Text];
        TypesList: List of [Text];
        PassengerName: Text;
        PassengerIDText: Text;
        PassengerType: Text;
        PassengerID: BigInteger;
        SLNo: Integer;
    begin
        if NamesText = '' then
            exit;

        NamesList := NamesText.Split(',');
        IDsList := IDsText.Split(',');
        TypesList := TypesText.Split(',');

        for SLNo := 1 to NamesList.Count do begin

            PassengerName :=
                DelChr(NamesList.Get(SLNo), '<>', ' ');

            PassengerIDText :=
                DelChr(IDsList.Get(SLNo), '<>', ' ');

            PassengerType :=
                DelChr(TypesList.Get(SLNo), '<>', ' ');

            if not Evaluate(PassengerID, PassengerIDText) then
                Error(
                    'Invalid Passenger ID at Excel row %1, passenger %2.',
                    RowNo, SLNo);

            Clear(Passenger);
            Passenger.Init();

            Passenger."Ref No./AQ Number" := AQNumber;
            Passenger.PNR := PNRValue;
            Passenger."SL No." := SLNo;
            Passenger."Passenger Name" :=
                CopyStr(PassengerName, 1, 100);
            Passenger.ID := PassengerID;
            Passenger.Type :=
                CopyStr(PassengerType, 1, 50);

            Passenger.Insert(true);
        end;
    end;

    local procedure ParseBoolean(
        InputText: Text;
        RowNo: Integer): Boolean
    begin
        InputText :=
            UpperCase(DelChr(InputText, '<>', ' '));

        case InputText of
            '', 'FALSE', 'NO', '0':
                exit(false);

            'TRUE', 'YES', '1':
                exit(true);

            else
                Error(
                    'Invalid Boolean value "%1" at Excel row %2.',
                    InputText, RowNo);
        end;
    end;

    local procedure ParseDecimal(
        InputText: Text;
        RowNo: Integer;
        FieldName: Text): Decimal
    var
        DecimalValue: Decimal;
    begin
        InputText := DelChr(InputText, '<>', ' ');

        if InputText = '' then
            exit(0);

        if Evaluate(DecimalValue, InputText) then
            exit(DecimalValue);

        Error(
            'Invalid %1 "%2" at Excel row %3.',
            FieldName, InputText, RowNo);
    end;

    local procedure ParseExcelDateTime(
        InputText: Text;
        RowNo: Integer;
        ColumnNo: Integer): DateTime
    var
        DateParts: List of [Text];
        DateValue: Date;
        TimeValue: Time;
        DateText: Text;
        TimeText: Text;
        DayNo: Integer;
        MonthNo: Integer;
        YearNo: Integer;
        SpacePosition: Integer;
        ExcelSerial: Decimal;
        WholeDays: Integer;
        Milliseconds: Duration;
    begin
        InputText := DelChr(InputText, '<>', ' ');

        if InputText = '' then
            exit(0DT);

        // Excel numeric serial date/time.
        if (StrPos(InputText, '-') = 0) and
           (StrPos(InputText, '/') = 0) and
           (StrPos(InputText, ':') = 0)
        then begin
            if Evaluate(ExcelSerial, InputText) then begin
                if ExcelSerial < 1 then
                    Error(
                        'Invalid Excel date at row %1, column %2.',
                        RowNo, ColumnNo);

                WholeDays := Round(ExcelSerial, 1, '<');

                DateValue :=
                    DMY2Date(30, 12, 1899) + WholeDays;

                Milliseconds :=
                    Round(
                        (ExcelSerial - WholeDays) * 86400000,
                        1,
                        '=');

                exit(
                    CreateDateTime(DateValue, 0T) +
                    Milliseconds);
            end;
        end;

        SpacePosition := StrPos(InputText, ' ');

        if SpacePosition > 0 then begin
            DateText :=
                CopyStr(InputText, 1, SpacePosition - 1);

            TimeText :=
                CopyStr(InputText, SpacePosition + 1);
        end else begin
            DateText := InputText;
            TimeText := '';
        end;

        DateText := DateText.Replace('/', '-');
        DateParts := DateText.Split('-');

        if DateParts.Count <> 3 then
            Error(
                'Invalid date "%1" at Excel row %2, column %3.',
                DateText, RowNo, ColumnNo);

        // yyyy-MM-dd or dd-MM-yyyy.
        if StrLen(DateParts.Get(1)) = 4 then begin
            if not Evaluate(YearNo, DateParts.Get(1)) then
                Error('Invalid year at row %1.', RowNo);

            if not Evaluate(MonthNo, DateParts.Get(2)) then
                Error('Invalid month at row %1.', RowNo);

            if not Evaluate(DayNo, DateParts.Get(3)) then
                Error('Invalid day at row %1.', RowNo);
        end else begin
            if not Evaluate(DayNo, DateParts.Get(1)) then
                Error('Invalid day at row %1.', RowNo);

            if not Evaluate(MonthNo, DateParts.Get(2)) then
                Error('Invalid month at row %1.', RowNo);

            if not Evaluate(YearNo, DateParts.Get(3)) then
                Error('Invalid year at row %1.', RowNo);
        end;

        if not TryCreateDate(DayNo, MonthNo, YearNo) then
            Error(
                'Invalid calendar date "%1" at Excel row %2.',
                DateText, RowNo);

        DateValue := DMY2Date(DayNo, MonthNo, YearNo);

        if TimeText = '' then
            TimeValue := 0T
        else
            if not Evaluate(TimeValue, TimeText) then
                Error(
                    'Invalid time "%1" at Excel row %2.',
                    TimeText, RowNo);

        exit(CreateDateTime(DateValue, TimeValue));
    end;

    [TryFunction]
    local procedure TryCreateDate(
        DayNo: Integer;
        MonthNo: Integer;
        YearNo: Integer)
    var
        ParsedDate: Date;
    begin
        ParsedDate := DMY2Date(DayNo, MonthNo, YearNo);
    end;

    local procedure GetCellText(
        var ExcelBuffer: Record "Excel Buffer" temporary;
        RowNo: Integer;
        ColumnNo: Integer): Text
    begin
        ExcelBuffer.Reset();
        ExcelBuffer.SetRange("Row No.", RowNo);
        ExcelBuffer.SetRange("Column No.", ColumnNo);

        if ExcelBuffer.FindFirst() then
            exit(
                DelChr(
                    ExcelBuffer."Cell Value as Text",
                    '<>', ' '));

        exit('');
    end;
}
