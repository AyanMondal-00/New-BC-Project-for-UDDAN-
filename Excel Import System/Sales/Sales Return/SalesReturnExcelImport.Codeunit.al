
codeunit 50333 "Sales Return Excel Import"
{
    procedure ImportFromExcel()
    var
        ExcelBuffer: Record "Excel Buffer" temporary;
        SalesReturn: Record "Sales Return";
        ExistingSalesReturn: Record "Sales Return";
        InStream: InStream;
        FileName: Text;
        SheetName: Text;
        LastRow: Integer;
        RowNo: Integer;
        CellValue: Text;
        InvoiceNo: Code[50];
        ImportedCount: Integer;
        DuplicateCount: Integer;
        BlankRowCount: Integer;
    begin
        if not UploadIntoStream(
            'Select Excel File',
            '',
            'Excel Files (*.xlsx)|*.xlsx',
            FileName,
            InStream)
        then
            exit;

        SheetName := ExcelBuffer.SelectSheetsNameStream(InStream);
        if SheetName = '' then
            exit;

        ExcelBuffer.OpenBookStream(InStream, SheetName);
        ExcelBuffer.ReadSheet();

        ExcelBuffer.Reset();
        if ExcelBuffer.FindLast() then
            LastRow := ExcelBuffer."Row No.";

        for RowNo := 2 to LastRow do begin
            if (GetCellText(ExcelBuffer, RowNo, 3) = '') and
               (GetCellText(ExcelBuffer, RowNo, 4) = '') and
               (GetCellText(ExcelBuffer, RowNo, 5) = '') and
               (GetCellText(ExcelBuffer, RowNo, 7) = '')
            then
                BlankRowCount += 1
            else begin
                InvoiceNo := CopyStr(
                    GetCellText(ExcelBuffer, RowNo, 4),
                    1,
                    MaxStrLen(InvoiceNo));

                ExistingSalesReturn.Reset();
                Clear(ExistingSalesReturn);

                if InvoiceNo <> '' then begin
                    ExistingSalesReturn.SetRange(
                        "Invoice No.", InvoiceNo);
                end;

                if (InvoiceNo <> '') and
                   ExistingSalesReturn.FindFirst()
                then
                    DuplicateCount += 1
                else begin
                    SalesReturn.Init();

                    // Serial No. is generated by table OnInsert.
                    // Excel Column 1 is intentionally ignored.

                    // Column 2: Entry Date (DateTime)
                    CellValue := GetCellText(ExcelBuffer, RowNo, 2);
                    if CellValue <> '' then
                        SalesReturn."Entry Date" :=
                            ParseExcelDateTime(CellValue, RowNo, 2);

                    // Column 3: Bill No.
                    SalesReturn."Bill No." :=
                        CopyStr(GetCellText(ExcelBuffer, RowNo, 3),
                            1, MaxStrLen(SalesReturn."Bill No."));

                    // Column 4: Invoice No.
                    SalesReturn."Invoice No." := InvoiceNo;

                    // Column 5: Return No.
                    SalesReturn."Return No." :=
                        CopyStr(GetCellText(ExcelBuffer, RowNo, 5),
                            1, MaxStrLen(SalesReturn."Return No."));

                    // Column 6: Agency ID
                    SalesReturn."Agency ID" :=
                        CopyStr(GetCellText(ExcelBuffer, RowNo, 6),
                            1, MaxStrLen(SalesReturn."Agency ID"));

                    // Column 7: A/C Name
                    SalesReturn."A/C Name" :=
                        CopyStr(GetCellText(ExcelBuffer, RowNo, 7),
                            1, MaxStrLen(SalesReturn."A/C Name"));

                    // Column 8: Country
                    SalesReturn.Country :=
                        CopyStr(GetCellText(ExcelBuffer, RowNo, 8),
                            1, MaxStrLen(SalesReturn.Country));

                    // Column 9: State
                    SalesReturn.State :=
                        CopyStr(GetCellText(ExcelBuffer, RowNo, 9),
                            1, MaxStrLen(SalesReturn.State));

                    // Column 10: City
                    SalesReturn.City :=
                        CopyStr(GetCellText(ExcelBuffer, RowNo, 10),
                            1, MaxStrLen(SalesReturn.City));

                    // Column 11: Sector
                    SalesReturn.Sector :=
                        CopyStr(GetCellText(ExcelBuffer, RowNo, 11),
                            1, MaxStrLen(SalesReturn.Sector));

                    // Column 12: Type
                    SalesReturn.Type :=
                        CopyStr(GetCellText(ExcelBuffer, RowNo, 12),
                            1, MaxStrLen(SalesReturn.Type));

                    // Column 13: Travel Date (DateTime)
                    CellValue := GetCellText(ExcelBuffer, RowNo, 13);
                    if CellValue <> '' then
                        SalesReturn."Travel Date" :=
                            ParseExcelDateTime(CellValue, RowNo, 13);

                    // Column 14: Time
                    CellValue := GetCellText(ExcelBuffer, RowNo, 14);
                    if CellValue <> '' then
                        SalesReturn.Time :=
                            ParseExcelTime(CellValue, RowNo, 14);

                    // Column 15: Airline
                    SalesReturn.Airline :=
                        CopyStr(GetCellText(ExcelBuffer, RowNo, 15),
                            1, MaxStrLen(SalesReturn.Airline));

                    // Column 16: Airline Code
                    SalesReturn."Airline Code" :=
                        CopyStr(GetCellText(ExcelBuffer, RowNo, 16),
                            1, MaxStrLen(SalesReturn."Airline Code"));

                    // Column 17: PNR
                    SalesReturn.PNR :=
                        CopyStr(GetCellText(ExcelBuffer, RowNo, 17),
                            1, MaxStrLen(SalesReturn.PNR));

                    // Column 18: Reference (optional)
                    SalesReturn.Reference :=
                        CopyStr(GetCellText(ExcelBuffer, RowNo, 18),
                            1, MaxStrLen(SalesReturn.Reference));

                    // Column 19: Narration (optional)
                    SalesReturn.Narration :=
                        CopyStr(GetCellText(ExcelBuffer, RowNo, 19),
                            1, MaxStrLen(SalesReturn.Narration));

                    // Column 20: PAX
                    CellValue := GetCellText(ExcelBuffer, RowNo, 20);
                    if CellValue <> '' then
                        if not Evaluate(SalesReturn.PAX, CellValue) then
                            Error(
                                'Invalid PAX value "%1" at row %2.',
                                CellValue, RowNo);

                    // Column 21: Base Fare
                    CellValue := GetCellText(ExcelBuffer, RowNo, 21);
                    if CellValue <> '' then
                        if not Evaluate(SalesReturn."Base Fare", CellValue) then
                            Error(
                                'Invalid Base Fare "%1" at row %2.',
                                CellValue, RowNo);

                    // Column 22: Taxable Value
                    CellValue := GetCellText(ExcelBuffer, RowNo, 22);
                    if CellValue <> '' then
                        if not Evaluate(SalesReturn."Taxable Value", CellValue) then
                            Error(
                                'Invalid Taxable Value "%1" at row %2.',
                                CellValue, RowNo);

                    // Column 23: CGST
                    CellValue := GetCellText(ExcelBuffer, RowNo, 23);
                    if CellValue <> '' then
                        if not Evaluate(SalesReturn.CGST, CellValue) then
                            Error('Invalid CGST at row %1.', RowNo);

                    // Column 24: SGST
                    CellValue := GetCellText(ExcelBuffer, RowNo, 24);
                    if CellValue <> '' then
                        if not Evaluate(SalesReturn.SGST, CellValue) then
                            Error('Invalid SGST at row %1.', RowNo);

                    // Column 25: IGST
                    CellValue := GetCellText(ExcelBuffer, RowNo, 25);
                    if CellValue <> '' then
                        if not Evaluate(SalesReturn.IGST, CellValue) then
                            Error('Invalid IGST at row %1.', RowNo);

                    // Column 26: Sold Value
                    CellValue := GetCellText(ExcelBuffer, RowNo, 26);
                    if CellValue <> '' then
                        if not Evaluate(SalesReturn."Sold Value", CellValue) then
                            Error('Invalid Sold Value at row %1.', RowNo);

                    // Column 27: XXLN Charges
                    CellValue := GetCellText(ExcelBuffer, RowNo, 27);
                    if CellValue <> '' then
                        if not Evaluate(SalesReturn."XXLN Charges", CellValue) then
                            Error('Invalid XXLN Charges at row %1.', RowNo);

                    // Column 28: Refund Amount
                    CellValue := GetCellText(ExcelBuffer, RowNo, 28);
                    if CellValue <> '' then
                        if not Evaluate(SalesReturn."Refund Amount", CellValue) then
                            Error('Invalid Refund Amount at row %1.', RowNo);

                    // Column 29: Sale Type
                    CellValue := GetCellText(ExcelBuffer, RowNo, 29);
                    if CellValue <> '' then
                        if not Evaluate(SalesReturn."Sale Type", CellValue) then
                            Error(
                                'Invalid Sale Type "%1" at row %2. Use Own or ThirdParty.',
                                CellValue, RowNo);

                    // Column 30: Supplier
                    SalesReturn.Supplier :=
                        CopyStr(GetCellText(ExcelBuffer, RowNo, 30),
                            1, MaxStrLen(SalesReturn.Supplier));

                    // Generate Serial No. through the table trigger.
                    SalesReturn.Insert(true);
                    ImportedCount += 1;
                end;
            end;
        end;

        Message(
            'Sales Return Excel Import Completed.\' +
            'Imported: %1\' +
            'Duplicate Invoice No.: %2\' +
            'Blank rows skipped: %3',
            ImportedCount,
            DuplicateCount,
            BlankRowCount);
    end;

    local procedure ParseExcelTime(
        InputText: Text;
        RowNo: Integer;
        ColumnNo: Integer): Time
    var
        ParsedTime: Time;
    begin
        InputText := DelChr(InputText, '<>', ' ');

        if Evaluate(ParsedTime, InputText) then
            exit(ParsedTime);

        Error(
            'Invalid time "%1" in Excel row %2, column %3.',
            InputText, RowNo, ColumnNo);
    end;

    local procedure ParseExcelDateTime(
        InputText: Text;
        RowNo: Integer;
        ColumnNo: Integer): DateTime
    var
        ParsedDate: Date;
        ParsedTime: Time;
        DateTimeResult: DateTime;
        DateText: Text;
        TimeText: Text;
        SeparatorPosition: Integer;
    begin
        InputText := DelChr(InputText, '<>', ' ');

        SeparatorPosition := StrPos(InputText, ' ');

        if SeparatorPosition > 0 then begin
            DateText := CopyStr(InputText, 1, SeparatorPosition - 1);
            TimeText := CopyStr(InputText, SeparatorPosition + 1);
        end else begin
            DateText := InputText;
            TimeText := '';
        end;

        // Parse the date portion.
        if not ParseDateText(DateText, ParsedDate) then
            Error(
                'Invalid date "%1" in Excel row %2, column %3.',
                DateText, RowNo, ColumnNo);

        // Date only: use midnight.
        if TimeText = '' then
            exit(CreateDateTime(ParsedDate, 0T));

        // Parse the time portion.
        if not Evaluate(ParsedTime, TimeText) then
            Error(
                'Invalid time "%1" in Excel row %2, column %3.',
                TimeText, RowNo, ColumnNo);

        // Preserve BOTH the Excel date and time.
        DateTimeResult := CreateDateTime(ParsedDate, ParsedTime);
        exit(DateTimeResult);
    end;

    local procedure ParseDateText(
        InputText: Text;
        var ParsedDate: Date): Boolean
    var
        Part1: Text;
        Part2: Text;
        Part3: Text;
        Separator: Text[1];
        SeparatorPosition: Integer;
        SecondSeparatorPosition: Integer;
        FirstNumber: Integer;
        SecondNumber: Integer;
        ThirdNumber: Integer;
    begin
        // First try the Business Central regional date format.
        if Evaluate(ParsedDate, InputText) then
            exit(true);

        // Support dd-MM-yyyy, dd/MM/yyyy and yyyy-MM-dd.
        SeparatorPosition := StrPos(InputText, '-');

        if SeparatorPosition = 0 then
            SeparatorPosition := StrPos(InputText, '/');

        if SeparatorPosition = 0 then
            exit(false);

        Separator := CopyStr(InputText, SeparatorPosition, 1);

        Part1 := CopyStr(InputText, 1, SeparatorPosition - 1);

        SecondSeparatorPosition :=
            StrPos(
                CopyStr(InputText, SeparatorPosition + 1),
                Separator);

        if SecondSeparatorPosition = 0 then
            exit(false);

        SecondSeparatorPosition += SeparatorPosition;

        Part2 := CopyStr(
            InputText,
            SeparatorPosition + 1,
            SecondSeparatorPosition - SeparatorPosition - 1);

        Part3 := CopyStr(
            InputText,
            SecondSeparatorPosition + 1);

        if not Evaluate(FirstNumber, Part1) then
            exit(false);

        if not Evaluate(SecondNumber, Part2) then
            exit(false);

        if not Evaluate(ThirdNumber, Part3) then
            exit(false);

        // yyyy-MM-dd or yyyy/MM/dd
        if StrLen(Part1) = 4 then
            exit(
                TryCreateDate(
                    ThirdNumber,
                    SecondNumber,
                    FirstNumber,
                    ParsedDate));

        // dd-MM-yyyy or dd/MM/yyyy
        exit(
            TryCreateDate(
                FirstNumber,
                SecondNumber,
                ThirdNumber,
                ParsedDate));
    end;

    [TryFunction]
    local procedure TryCreateDate(
        DayNo: Integer;
        MonthNo: Integer;
        YearNo: Integer;
        var ParsedDate: Date)
    begin
        ParsedDate := DMY2Date(DayNo, MonthNo, YearNo);
    end;


    local procedure GetCellText(
        var ExcelBuffer: Record "Excel Buffer" temporary;
        RowNo: Integer;
        ColumnNo: Integer): Text
    begin
        ExcelBuffer.Reset();
        ExcelBuffer.SetRange("Row No.", RowNo);
        ExcelBuffer.SetRange("Column No.", ColumnNo);

        if ExcelBuffer.FindFirst() then
            exit(ExcelBuffer."Cell Value as Text");

        exit('');
    end;
}
