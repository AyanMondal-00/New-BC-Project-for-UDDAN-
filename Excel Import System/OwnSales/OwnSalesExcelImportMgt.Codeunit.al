
codeunit 50430 "Own Sales Excel Import Mgt."
{
    procedure ImportFromExcel()
    var
        TempExcelBuffer: Record "Excel Buffer" temporary;
        NormalSales: Record "Normal Sales";
        UploadInStream: InStream;
        FileName: Text;
        SheetName: Text;
        RowNo: Integer;
        LastRowNo: Integer;
        ImportedCount: Integer;
        SkippedCount: Integer;
        PNRValue: Text;
        RefNoValue: BigInteger;
        PassengerNamesValue: Text;
    begin
        if not UploadIntoStream(
            'Select Own Sales Excel File',
            '',
            'Excel Files (*.xlsx)|*.xlsx',
            FileName,
            UploadInStream)
        then
            exit;

        SheetName := TempExcelBuffer.SelectSheetsNameStream(UploadInStream);
        UploadInStream.ResetPosition();

        TempExcelBuffer.OpenBookStream(UploadInStream, SheetName);
        TempExcelBuffer.ReadSheet();

        TempExcelBuffer.Reset();
        if not TempExcelBuffer.FindLast() then
            Error('The selected Excel file is empty.');

        LastRowNo := TempExcelBuffer."Row No.";

        if LastRowNo < 2 then
            Error('No data rows found. Row 1 must contain the column headers.');

        for RowNo := 2 to LastRowNo do begin
            PNRValue := GetCellValue(TempExcelBuffer, RowNo, 9);
            if PNRValue <> '' then begin
                Clear(NormalSales);
                NormalSales.Init();

                // Serial No. is generated by the table OnInsert trigger.
                NormalSales.Validate("Date",
                    GetDateTimeValue(GetCellValue(TempExcelBuffer, RowNo, 2)));

                NormalSales.Validate("Invoice Number",
                    CopyStr(GetCellValue(TempExcelBuffer, RowNo, 3), 1, 50));

                NormalSales.Validate("Agency ID",
                    CopyStr(GetCellValue(TempExcelBuffer, RowNo, 4), 1, 30));

                NormalSales.Validate("Agency Name",
                    CopyStr(GetCellValue(TempExcelBuffer, RowNo, 5), 1, 100));

                if not Evaluate(
                    RefNoValue,
                    GetCellValue(TempExcelBuffer, RowNo, 6))
                then
                    Error('Invalid Ref No./AQ Number at Excel row %1.', RowNo);

                NormalSales.Validate("Ref No./AQ Number", RefNoValue);

                NormalSales.Validate("Select",
                    GetBooleanValue(GetCellValue(TempExcelBuffer, RowNo, 7), RowNo, 'Select'));

                NormalSales.Validate("Sales Invoice Created",
                    GetBooleanValue(GetCellValue(TempExcelBuffer, RowNo, 8), RowNo, 'Sales Invoice Created'));

                NormalSales.Validate("PNR", CopyStr(PNRValue, 1, 10));

                NormalSales.Validate(Pax,
                    GetIntegerValue(GetCellValue(TempExcelBuffer, RowNo, 11), RowNo, 'Pax'));

                NormalSales.Validate("Travel Date",
                    GetDateTimeValue(GetCellValue(TempExcelBuffer, RowNo, 12)));

                NormalSales.Validate(Sector,
                    CopyStr(GetCellValue(TempExcelBuffer, RowNo, 13), 1, 200));

                NormalSales.Validate(Type,
                    CopyStr(GetCellValue(TempExcelBuffer, RowNo, 14), 1, 50));

                NormalSales.Validate("Base Fare",
                    GetDecimalValue(GetCellValue(TempExcelBuffer, RowNo, 15), RowNo, 'Base Fare'));

                NormalSales.Validate("Other Charges",
                    GetDecimalValue(GetCellValue(TempExcelBuffer, RowNo, 16), RowNo, 'Other Charges'));

                NormalSales.CalculateGST();

                NormalSales.Insert(true);

                PassengerNamesValue := GetCellValue(TempExcelBuffer, RowNo, 10);
                if PassengerNamesValue <> '' then
                    ImportPassengerNames(RefNoValue, CopyStr(PNRValue, 1, 10), PassengerNamesValue);
                ImportedCount += 1;
            end else
                SkippedCount += 1;
        end;

        Message(
            'Own Sales Excel import completed.\Imported: %1\Skipped (blank PNR): %2',
            ImportedCount,
            SkippedCount);
    end;

    local procedure GetCellValue(
        var TempExcelBuffer: Record "Excel Buffer" temporary;
        RowNo: Integer;
        ColumnNo: Integer): Text
    begin
        TempExcelBuffer.Reset();
        TempExcelBuffer.SetRange("Row No.", RowNo);
        TempExcelBuffer.SetRange("Column No.", ColumnNo);

        if TempExcelBuffer.FindFirst() then
            exit(TempExcelBuffer."Cell Value as Text");

        exit('');
    end;

    local procedure GetBooleanValue(ValueText: Text; RowNo: Integer; FieldName: Text): Boolean
    var
        NormalizedValue: Text;
        BooleanValue: Boolean;
    begin
        NormalizedValue := UpperCase(DelChr(ValueText, '=', ' '));

        case NormalizedValue of
            'TRUE', 'YES', '1':
                exit(true);
            'FALSE', 'NO', '0', '':
                exit(false);
            else
                if Evaluate(BooleanValue, ValueText) then
                    exit(BooleanValue);

                Error(
                    'Invalid value "%1" for %2 at Excel row %3. Use TRUE/FALSE or Yes/No.',
                    ValueText, FieldName, RowNo);
        end;
    end;

    local procedure GetIntegerValue(ValueText: Text; RowNo: Integer; FieldName: Text): Integer
    var
        IntegerValue: Integer;
    begin
        if ValueText = '' then
            exit(0);

        if not Evaluate(IntegerValue, ValueText) then
            Error('Invalid %1 at Excel row %2: %3', FieldName, RowNo, ValueText);

        exit(IntegerValue);
    end;

    local procedure GetDecimalValue(ValueText: Text; RowNo: Integer; FieldName: Text): Decimal
    var
        DecimalValue: Decimal;
    begin
        if ValueText = '' then
            exit(0);

        if not Evaluate(DecimalValue, ValueText) then
            Error('Invalid %1 at Excel row %2: %3', FieldName, RowNo, ValueText);

        exit(DecimalValue);
    end;

    local procedure GetDateTimeValue(ValueText: Text): DateTime
    var
        DateTimeValue: DateTime;
        DateValue: Date;
        TimeValue: Time;
        ExcelSerial: Decimal;
        WholeDays: Integer;
        Milliseconds: Duration;
        BaseDate: Date;
        CleanText: Text;
        DatePart: Text;
        TimePart: Text;
        DateParts: List of [Text];
        TimeParts: List of [Text];
        SeparatorPosition: Integer;
        DayNo: Integer;
        MonthNo: Integer;
        YearNo: Integer;
        HourNo: Integer;
        MinuteNo: Integer;
        SecondNo: Integer;
        ISODateText: Text;
    begin
        CleanText := DelChr(ValueText, '<>', ' ');

        if CleanText = '' then
            exit(0DT);

        // Support text format: DD-MM-YYYY HH:MM
        SeparatorPosition := StrPos(CleanText, ' ');

        if SeparatorPosition > 0 then begin
            DatePart := CopyStr(CleanText, 1, SeparatorPosition - 1);
            TimePart := CopyStr(CleanText, SeparatorPosition + 1);

            DatePart := DatePart.Replace('/', '-');
            DateParts := DatePart.Split('-');

            if DateParts.Count = 3 then begin
                if StrLen(DateParts.Get(1)) = 4 then begin
                    if not Evaluate(YearNo, DateParts.Get(1)) then
                        Error('Invalid year in date "%1".', DatePart);

                    if not Evaluate(MonthNo, DateParts.Get(2)) then
                        Error('Invalid month in date "%1".', DatePart);

                    if not Evaluate(DayNo, DateParts.Get(3)) then
                        Error('Invalid day in date "%1".', DatePart);
                end else begin
                    if not Evaluate(DayNo, DateParts.Get(1)) then
                        Error('Invalid day in date "%1".', DatePart);

                    if not Evaluate(MonthNo, DateParts.Get(2)) then
                        Error('Invalid month in date "%1".', DatePart);

                    if not Evaluate(YearNo, DateParts.Get(3)) then
                        Error('Invalid year in date "%1".', DatePart);
                end;

                // Validate the calendar date using ISO format.
                ISODateText :=
                    Format(YearNo) + '-' +
                    PadNumber(MonthNo) + '-' +
                    PadNumber(DayNo);

                if not Evaluate(DateValue, ISODateText, 9) then
                    Error('Invalid calendar date "%1".', DatePart);

                TimeParts := TimePart.Split(':');

                if (TimeParts.Count < 2) or (TimeParts.Count > 3) then
                    Error('Invalid time "%1". Use HH:MM or HH:MM:SS.', TimePart);

                if not Evaluate(HourNo, TimeParts.Get(1)) then
                    Error('Invalid hour in time "%1".', TimePart);

                if not Evaluate(MinuteNo, TimeParts.Get(2)) then
                    Error('Invalid minute in time "%1".', TimePart);

                Clear(SecondNo);
                if TimeParts.Count = 3 then
                    if not Evaluate(SecondNo, TimeParts.Get(3)) then
                        Error('Invalid second in time "%1".', TimePart);

                if (HourNo < 0) or (HourNo > 23) or
                   (MinuteNo < 0) or (MinuteNo > 59) or
                   (SecondNo < 0) or (SecondNo > 59)
                then
                    Error('Invalid time "%1". Use 24-hour time.', TimePart);

                TimeValue :=
                    000000T +
                    (HourNo * 3600000) +
                    (MinuteNo * 60000) +
                    (SecondNo * 1000);

                exit(CreateDateTime(DateValue, TimeValue));
            end;
        end;

        // Support other valid DateTime formats.
        if Evaluate(DateTimeValue, CleanText) then
            exit(DateTimeValue);

        if Evaluate(DateValue, CleanText) then
            exit(CreateDateTime(DateValue, 0T));

        // Support Excel serial DateTime values.
        if Evaluate(ExcelSerial, CleanText) then begin
            if ExcelSerial < 1 then
                Error(
                    'The Excel cell contains only a time or an invalid date: %1.',
                    CleanText);

            WholeDays := Round(ExcelSerial, 1, '<');
            BaseDate := DMY2Date(30, 12, 1899);
            DateValue := BaseDate + WholeDays;

            Milliseconds := Round(
                (ExcelSerial - WholeDays) * 86400000,
                1,
                '=');

            exit(CreateDateTime(DateValue, 0T) + Milliseconds);
        end;

        Error(
            'Cannot read date/time "%1". Use DD-MM-YYYY HH:MM, e.g. 28-09-2026 19:30.',
            ValueText);
    end;

    local procedure PadNumber(NumberValue: Integer): Text
    begin
        if NumberValue < 10 then
            exit('0' + Format(NumberValue));

        exit(Format(NumberValue));
    end;

    local procedure ImportPassengerNames(RefNo: BigInteger; PNRCode: Text[10]; NamesText: Text)
    var
        OwnSalesPassengerName: Record "Own Sales Passenger Name";
        NameList: List of [Text];
        SingleName: Text;
        SLNo: Integer;
    begin
        OwnSalesPassengerName.Reset();
        OwnSalesPassengerName.SetRange("Ref No./AQ Number", RefNo);
        OwnSalesPassengerName.SetRange("PNR", PNRCode);
        if not OwnSalesPassengerName.IsEmpty() then
            OwnSalesPassengerName.DeleteAll();

        NameList := NamesText.Split(',');
        SLNo := 1;
        foreach SingleName in NameList do begin
            SingleName := DelChr(SingleName, '<>', ' ');
            if SingleName <> '' then begin
                Clear(OwnSalesPassengerName);
                OwnSalesPassengerName.Init();
                OwnSalesPassengerName.Validate("Ref No./AQ Number", RefNo);
                OwnSalesPassengerName.Validate("PNR", PNRCode);
                OwnSalesPassengerName.Validate("SL No.", SLNo);
                OwnSalesPassengerName.Validate("Passenger Name", CopyStr(SingleName, 1, 100));
                OwnSalesPassengerName.Insert(true);
                SLNo += 1;
            end;
        end;
    end;
}
